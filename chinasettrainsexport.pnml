/* ==========================================================================
 *  China Set: Export Rail Vehicles Add-on
 *  chinasettrainsexport.pnml -- build entry point
 *
 *  This file is fed to the C preprocessor by the Makefile:
 *
 *      gcc -E -x c chinasettrainsexport.pnml > chinasettrainsexport.nml
 *      nmlc -c chinasettrainsexport.nml -o chinasettrainsexport.grf
 *
 *  so #include, #define and #if all work, and comments are C style.
 *  The generated block near the bottom is rewritten by genpnml.py.
 * ========================================================================== */

