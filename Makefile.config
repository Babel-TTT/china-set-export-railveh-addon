# Makefile.config -- local overrides for the build
# All values here are optional; the Makefile provides defaults.
# Uncomment and adapt if your tools are not on PATH.

# tools
# PYTHON ?= python3

# sprites
# GORENDER ?= renderobject --palette "ttd_palette.json" -overwrite

# code
# NMLC ?= nmlc -c
# GCC  ?= gcc

# vehicle code generation
# GEN_SCRIPT ?= ./genpnml.py
# GEN_DATA   ?= data
# GEN_OUT    ?= src
