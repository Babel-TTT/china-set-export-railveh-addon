/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_ss8ex_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_EXPORT_BLUE);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_ss8ex_visual, position_in_articulated_veh % 1) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_ss8ex_livery_auto, build_year) {
    spriteset_ss8ex_exblue;
}

switch (FEAT_TRAINS, SELF, switch_ss8ex_livery, cargo_subtype) {
    0: switch_ss8ex_livery_auto;
    1: spriteset_ss8ex_exblue;
    switch_ss8ex_livery_auto;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_ss8ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "ss8ex")
}

spriteset (spriteset_ss8ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-electric", "ss8ex")
}

spriteset (spriteset_ss8ex_exblue, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "ss8ex-exblue")
}

spriteset (spriteset_ss8ex_purchase_exblue, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-electric", "ss8ex-exblue")
}

