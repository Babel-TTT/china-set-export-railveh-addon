 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_ss4ex_articulated_part, extra_callback_info1) {
    1..2: return ss4ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_ss4ex_visual, position_in_articulated_veh % 3) {
    1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_ss4ex_capacity, position_in_articulated_veh % 3) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_ss4ex_power, position_in_articulated_veh % 3) {
    1: return 6400;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_ss4ex_weight, position_in_articulated_veh) {
    return 61;
}

switch (FEAT_TRAINS, SELF, switch_ss4ex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_ss4ex;
    empty_sprites;
}

