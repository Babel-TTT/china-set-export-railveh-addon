/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_hxd3ex_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_EXPORT_BLUE);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_hxd3ex_visual, position_in_articulated_veh % 1) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_hxd3ex_livery_auto, build_year) {
    spriteset_hxd3ex_exblue;
}

switch (FEAT_TRAINS, SELF, switch_hxd3ex_livery, cargo_subtype) {
    0: switch_hxd3ex_livery_auto;
    1: spriteset_hxd3ex_exblue;
    switch_hxd3ex_livery_auto;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_hxd3ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "hxd3ex")
}

spriteset (spriteset_hxd3ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-electric", "hxd3ex")
}

spriteset (spriteset_hxd3ex_exblue, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-electric", "hxd3ex-exblue")
}

spriteset (spriteset_hxd3ex_purchase_exblue, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-electric", "hxd3ex-exblue")
}

