// Begin HXD3EX
/* name callback: series name in the depot window */
item (FEAT_TRAINS, hxd3ex) {
    property {
        // Menu
        name:                           string(STR_NAME_HXD3EX);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_ELECTRIC;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2006,01,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        track_type:                     SAAA;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          120 km/h;
        power:                          7200 kW;
        weight:                         138 ton;
        tractive_effort_coefficient:    0.28;
        cost_factor:                    150;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            130;
        reliability_decay:              10;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_HXD3EX), string(STR_LIVERY_EXPORT, string(STR_EXPORT_BLUE)), string(STR_CAT_LOCO));
        name:                           switch_name_series;
        cargo_subtype_text:             switch_hxd3ex_cargo_subtype;
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_hxd3ex_livery;
        purchase:                       spriteset_hxd3ex_purchase;
        visual_effect_and_powered:      switch_hxd3ex_visual;

        // Stats
        cost_factor:                    150;
        running_cost_factor:            130 * runningcostfactor();
        purchase_running_cost_factor:   390;
    }
}

