/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_zycex_articulated_part, extra_callback_info1) {
    1..2: return zycex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_zycex_capacity, position_in_articulated_veh % 3) {
    1: return 60;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_zycex_weight, position_in_articulated_veh) {
    return 18;
}

switch (FEAT_TRAINS, SELF, switch_zycex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_zycex;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
