spriteset (spriteset_tm2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("iran/tm2", "tm2")
}

spriteset (spriteset_tm2_purchase_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("iran/tm2", "tm2-a")
}

spriteset (spriteset_tm2_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("iran/tm2", "tm2-a")
}

spriteset (spriteset_tm2_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("iran/tm2", "tm2-b")
}

spriteset (spriteset_tm2_purchase_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("iran/tm2", "tm2-b")
}

spriteset (spriteset_tm2_gfx_tm2_a, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("iran/tm2", "tm2-a")
}

spriteset (spriteset_tm2_gfx_tm2_b, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("iran/tm2", "tm2-b")
}

