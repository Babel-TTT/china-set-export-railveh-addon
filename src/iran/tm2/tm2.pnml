/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_tm2_cargo_subtype, cargo_subtype) {
    0: return string(STR_LV_AUTO);
    1: return string(STR_LV_FRONT);
    2: return string(STR_LV_BACK);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_tm2_articulated_part, extra_callback_info1) {
    1..2: return tm2;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_tm2_capacity, position_in_articulated_veh % 3) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_tm2_0_1_next, position_in_consist_from_end) {
    0..2: return spriteset_tm2_gfx_tm2_b;
    return spriteset_tm2_gfx_tm2_a;
}

switch (FEAT_TRAINS, SELF, switch_tm2_0_1, position_in_articulated_veh) {
    0..2: return spriteset_tm2_gfx_tm2_a;
    return switch_tm2_0_1_next;
}

switch (FEAT_TRAINS, SELF, switch_tm2_section_0, position_in_articulated_veh % 3) {
    0: empty_sprites;
    1: switch_tm2_0_1;
    2: empty_sprites;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_tm2_section_1, position_in_articulated_veh % 3) {
    1: spriteset_tm2_a;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_tm2_section_2, position_in_articulated_veh % 3) {
    1: spriteset_tm2_b;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_tm2_graphics, cargo_subtype) {
    0: switch_tm2_section_0;
    1: switch_tm2_section_1;
    2: switch_tm2_section_2;
    switch_tm2_section_0;
}

/* ==========================================================================
 *  SPRITESETS
