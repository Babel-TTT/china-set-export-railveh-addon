/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_sq8ex_articulated_part, extra_callback_info1) {
    1..2: return sq8ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_coal_stage, cargo_count) {
    0..5: spriteset_sq8ex;
    6..50: spriteset_sq8ex_sq8ex_coal;
    spriteset_sq8ex_sq8ex_coal;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_cargo_class, cargo_classes) {
    bitmask(CC_BULK): switch_sq8ex_coal_stage;
    spriteset_sq8ex;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_empty, cargo_count < 5) {
    0: switch_sq8ex_cargo_class;
    spriteset_sq8ex;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_capacity, position_in_articulated_veh % 3) {
    1: return 75;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_weight, position_in_articulated_veh) {
    return 7;
}

switch (FEAT_TRAINS, SELF, switch_sq8ex_graphics, position_in_articulated_veh % 3) {
    1: switch_sq8ex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_sq8ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "sq8ex")
}

spriteset (spriteset_sq8ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "sq8ex")
}

spriteset (spriteset_sq8ex_sq8ex_coal, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "sq8ex-coal")
}

