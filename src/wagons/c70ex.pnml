switch (FEAT_TRAINS, SELF, switch_c70ex_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_EXPORT_GRAY);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_articulated_part, extra_callback_info1) {
    1..2: return c70ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_coal_stage, cargo_count) {
    0..5: spriteset_c70ex;
    6..45: spriteset_c70ex_c70ex_coal;
    spriteset_c70ex_c70ex_coal;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_cont_stage, cargo_count) {
    0..5: spriteset_c70ex;
    6..40: spriteset_c70ex_c70ex_container;
    spriteset_c70ex_c70ex_container;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_cargo_class, cargo_classes) {
    bitmask(CC_BULK): switch_c70ex_coal_stage;
    bitmask(CC_MAIL): switch_c70ex_cont_stage;
    bitmask(CC_EXPRESS): switch_c70ex_cont_stage;
    bitmask(CC_COVERED): spriteset_c70ex_c70ex_cover;
    bitmask(CC_PIECE_GOODS): spriteset_c70ex_c70ex_cover;
    bitmask(CC_OVERSIZED): spriteset_c70ex_c70ex_cover;
    spriteset_c70ex;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_empty, cargo_count < 5) {
    0: switch_c70ex_cargo_class;
    spriteset_c70ex;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_gray_coal_stage, cargo_count) {
    0..5: spriteset_c70ex_gray;
    6..45: spriteset_c70ex_c70ex_coal_gray;
    spriteset_c70ex_c70ex_coal_gray;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_gray_cont_stage, cargo_count) {
    0..5: spriteset_c70ex_gray;
    6..40: spriteset_c70ex_c70ex_container_gray;
    spriteset_c70ex_c70ex_container_gray;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_gray_cargo_class, cargo_classes) {
    bitmask(CC_BULK): switch_c70ex_gray_coal_stage;
    bitmask(CC_MAIL): switch_c70ex_gray_cont_stage;
    bitmask(CC_EXPRESS): switch_c70ex_gray_cont_stage;
    bitmask(CC_COVERED): spriteset_c70ex_c70ex_cover_gray;
    bitmask(CC_PIECE_GOODS): spriteset_c70ex_c70ex_cover_gray;
    bitmask(CC_OVERSIZED): spriteset_c70ex_c70ex_cover_gray;
    spriteset_c70ex_gray;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_gray_empty, cargo_count < 5) {
    0: switch_c70ex_gray_cargo_class;
    spriteset_c70ex_gray;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_cargo_livery, cargo_subtype) {
    0: switch_c70ex_empty;
    1: switch_c70ex_gray_empty;
    switch_c70ex_empty;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_capacity, position_in_articulated_veh % 3) {
    1: return 70;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_weight, position_in_articulated_veh) {
    return 8;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_livery, cargo_subtype) {
    0: switch_c70ex_cargo_livery;
    1: switch_c70ex_cargo_livery;
    switch_c70ex_cargo_livery;
}

switch (FEAT_TRAINS, SELF, switch_c70ex_graphics, position_in_articulated_veh % 3) {
