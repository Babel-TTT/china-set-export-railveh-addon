        articulated_part:               switch_p70ex_articulated_part;

        // Stats
        length:                         switch_length_2_2_2;
        cargo_capacity:                 switch_p70ex_capacity;
        weight:                         switch_p70ex_weight;
        purchase_cargo_capacity:        70;
        cost_factor:                    8;
        running_cost_factor:            5 * runningcostfactor();
        purchase_running_cost_factor:   20;
    }
}

