/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_g70ex_articulated_part, extra_callback_info1) {
    1..2: return g70ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_oil_stage, cargo_count) {
    0..5: spriteset_g70ex;
    6..40: spriteset_g70ex_g70ex_oil;
    spriteset_g70ex_g70ex_oil;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_haz_stage, cargo_count) {
    0..5: spriteset_g70ex;
    6..40: spriteset_g70ex_g70ex_haz;
    spriteset_g70ex_g70ex_haz;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_cargo_class, cargo_classes) {
    bitmask(CC_LIQUID): switch_g70ex_oil_stage;
    bitmask(CC_HAZARDOUS): switch_g70ex_haz_stage;
    spriteset_g70ex;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_empty, cargo_count < 5) {
    0: switch_g70ex_cargo_class;
    spriteset_g70ex;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_capacity, position_in_articulated_veh % 3) {
    1: return 70;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_weight, position_in_articulated_veh) {
    return 8;
}

switch (FEAT_TRAINS, SELF, switch_g70ex_graphics, position_in_articulated_veh % 3) {
    1: switch_g70ex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_g70ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "g70ex")
}

spriteset (spriteset_g70ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "g70ex")
}

spriteset (spriteset_g70ex_g70ex_oil, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "g70ex-oil")
}

spriteset (spriteset_g70ex_g70ex_haz, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "g70ex-haz")
}

