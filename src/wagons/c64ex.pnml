/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_c64ex_articulated_part, extra_callback_info1) {
    1..2: return c64ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_coal_stage, cargo_count) {
    0..5: spriteset_c64ex;
    6..40: spriteset_c64ex_c64ex_coal;
    spriteset_c64ex_c64ex_coal;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_cargo_class, cargo_classes) {
    bitmask(CC_BULK): switch_c64ex_coal_stage;
    bitmask(CC_COVERED): spriteset_c64ex_c64ex_cover;
    bitmask(CC_PIECE_GOODS): spriteset_c64ex_c64ex_cover;
    spriteset_c64ex;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_empty, cargo_count < 5) {
    0: switch_c64ex_cargo_class;
    spriteset_c64ex;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_capacity, position_in_articulated_veh % 3) {
    1: return 64;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_weight, position_in_articulated_veh) {
    return 7;
}

switch (FEAT_TRAINS, SELF, switch_c64ex_graphics, position_in_articulated_veh % 3) {
    1: switch_c64ex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_c64ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "c64ex")
}

spriteset (spriteset_c64ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "c64ex")
}

spriteset (spriteset_c64ex_c64ex_coal, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "c64ex-coal")
}

spriteset (spriteset_c64ex_c64ex_cover, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "c64ex-cover")
}

