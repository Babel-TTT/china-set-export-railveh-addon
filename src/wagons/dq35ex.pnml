/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_dq35ex_articulated_part, extra_callback_info1) {
    1..2: return dq35ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_goods_stage, cargo_count) {
    0..2: spriteset_dq35ex;
    3..30: spriteset_dq35ex_dq35ex_goods;
    spriteset_dq35ex_dq35ex_goods;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_cargo_class, cargo_classes) {
    bitmask(CC_PIECE_GOODS): switch_dq35ex_goods_stage;
    bitmask(CC_OVERSIZED): switch_dq35ex_goods_stage;
    spriteset_dq35ex;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_empty, cargo_count < 5) {
    0: switch_dq35ex_cargo_class;
    spriteset_dq35ex;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_capacity, position_in_articulated_veh % 3) {
    1: return 50;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_weight, position_in_articulated_veh) {
    return 10;
}

switch (FEAT_TRAINS, SELF, switch_dq35ex_graphics, position_in_articulated_veh % 3) {
    1: switch_dq35ex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_dq35ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "dq35ex")
}

spriteset (spriteset_dq35ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "dq35ex")
}

spriteset (spriteset_dq35ex_dq35ex_goods, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "dq35ex-goods")
}

