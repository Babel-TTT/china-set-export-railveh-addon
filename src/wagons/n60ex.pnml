// Begin N60EX
item (FEAT_TRAINS, n60ex) {
    property {
        // Menu
        name:                           string(STR_NAME_N60EX);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1990,01,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        track_type:                     BACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PIECE_GOODS|CC_OVERSIZED|CC_COVERED|CC_BULK);
        non_refittable_cargo_classes:   bitmask(CC_PASSENGERS|CC_LIQUID);
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [YETI|YETY];
        refit_cost:                     0;
        default_cargo_type:             DEFAULT_CARGO_FIRST_REFITTABLE;
        ai_special_flag:                AI_FLAG_CARGO;
        cargo_capacity:                 60;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          100 km/h;
        power:                          0 hp;
        weight:                         20 ton;
        cost_factor:                    7;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            5;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_N60EX), string(STR_LIVERY_EXPORT, string(STR_ORIGINAL)), string(STR_CAT_WAGON));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_n60ex_graphics;
        purchase:                       spriteset_n60ex_purchase;
        articulated_part:               switch_n60ex_articulated_part;

        // Stats
        length:                         switch_length_2_2_2;
        cargo_capacity:                 switch_n60ex_capacity;
        weight:                         switch_n60ex_weight;
        purchase_cargo_capacity:        20;
        cost_factor:                    7;
        running_cost_factor:            5 * runningcostfactor();
        purchase_running_cost_factor:   20;
    }
}

