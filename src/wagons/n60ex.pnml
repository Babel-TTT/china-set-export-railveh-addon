switch (FEAT_TRAINS, SELF, switch_n60ex_articulated_part, extra_callback_info1) {
    1..2: return n60ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_n60ex_metal_stage, cargo_count) {
    0..5: spriteset_n60ex;
    6..30: spriteset_n60ex_n60ex_metal;
    spriteset_n60ex_n60ex_metal;
}

switch (FEAT_TRAINS, SELF, switch_n60ex_bucket_stage, cargo_count) {
    0..5: spriteset_n60ex;
    6..30: spriteset_n60ex_n60ex_bucket;
    spriteset_n60ex_n60ex_bucket;
}

