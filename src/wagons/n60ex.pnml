switch (FEAT_TRAINS, SELF, switch_n60ex_empty, cargo_count < 5) {
    0: switch_n60ex_cargo_type;
    spriteset_n60ex;
}

switch (FEAT_TRAINS, SELF, switch_n60ex_capacity, position_in_articulated_veh % 3) {
    1: return 60;
    return 0;
}

