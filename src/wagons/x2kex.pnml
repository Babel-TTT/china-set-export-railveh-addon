/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_x2kex_articulated_part, extra_callback_info1) {
    1..2: return x2kex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_cont_stage, cargo_count) {
    0..5: spriteset_x2kex;
    6..45: spriteset_x2kex_x2kex_cont;
    spriteset_x2kex_x2kex_cont;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_cargo_class, cargo_classes) {
    bitmask(CC_PIECE_GOODS): switch_x2kex_cont_stage;
    bitmask(CC_COVERED): switch_x2kex_cont_stage;
    bitmask(CC_OVERSIZED): switch_x2kex_cont_stage;
    spriteset_x2kex;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_empty, cargo_count < 5) {
    0: switch_x2kex_cargo_class;
    spriteset_x2kex;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_capacity, position_in_articulated_veh % 3) {
    1: return 80;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_weight, position_in_articulated_veh) {
    return 6;
}

switch (FEAT_TRAINS, SELF, switch_x2kex_graphics, position_in_articulated_veh % 3) {
    1: switch_x2kex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_x2kex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "x2kex")
}

spriteset (spriteset_x2kex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "x2kex")
}

spriteset (spriteset_x2kex_x2kex_cont, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "x2kex-cont")
}

