/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_jsq5ex_articulated_part, extra_callback_info1) {
    1..2: return jsq5ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_vehi_stage, cargo_count) {
    0..2: spriteset_jsq5ex;
    3..10: spriteset_jsq5ex_jsq5ex_vehi;
    spriteset_jsq5ex_jsq5ex_vehi;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_ensp_stage, cargo_count) {
    0..2: spriteset_jsq5ex;
    3..10: spriteset_jsq5ex_jsq5ex_ensp;
    spriteset_jsq5ex_jsq5ex_ensp;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_cargo_type, cargo_type_in_veh) {
    VEHI: switch_jsq5ex_vehi_stage;
    ENSP: switch_jsq5ex_ensp_stage;
    FMSP: switch_jsq5ex_ensp_stage;
    spriteset_jsq5ex;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_empty, cargo_count < 5) {
    0: switch_jsq5ex_cargo_type;
    spriteset_jsq5ex;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_capacity, position_in_articulated_veh % 3) {
    1: return 18;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_weight, position_in_articulated_veh) {
    return 10;
}

switch (FEAT_TRAINS, SELF, switch_jsq5ex_graphics, position_in_articulated_veh % 3) {
    1: switch_jsq5ex_empty;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_jsq5ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "jsq5ex")
}

spriteset (spriteset_jsq5ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons", "jsq5ex")
}

spriteset (spriteset_jsq5ex_jsq5ex_vehi, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "jsq5ex-vehi")
}

spriteset (spriteset_jsq5ex_jsq5ex_ensp, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons", "jsq5ex-ensp")
}

