    1..2: return ckd7a;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_ckd7a_visual, position_in_articulated_veh % 3) {
    1: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_ckd7a_capacity, position_in_articulated_veh % 3) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_ckd7a_power, position_in_articulated_veh % 3) {
    1: return 1400;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_ckd7a_weight, position_in_articulated_veh) {
    return 46;
}

switch (FEAT_TRAINS, SELF, switch_ckd7a_graphics, position_in_articulated_veh % 3) {
    1: spriteset_ckd7a;
    empty_sprites;
}

