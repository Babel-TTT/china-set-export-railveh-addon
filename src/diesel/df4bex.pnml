/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_df4bex_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_DPRK_LIVERY);
    2: return string(STR_UKRAINE_LIVERY);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_df4bex_visual, position_in_articulated_veh % 1) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_df4bex_livery, cargo_subtype) {
    0: spriteset_df4bex_dprk;
    1: spriteset_df4bex_dprk;
    2: spriteset_df4bex_ukraine;
    spriteset_df4bex_dprk;
}

/* ==========================================================================
 *  SPRITESETS
