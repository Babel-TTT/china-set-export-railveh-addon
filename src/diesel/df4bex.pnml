        // Graphics
        default:                        switch_df4bex_livery;
        purchase:                       spriteset_df4bex_purchase;
        visual_effect_and_powered:      switch_df4bex_visual;

        // Stats
        cost_factor:                    60;
        running_cost_factor:            55 * runningcostfactor();
        purchase_running_cost_factor:   165;
    }
