        retire_early:                   30;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          100 km/h;
        power:                          1985 kW;
        weight:                         138 ton;
        tractive_effort_coefficient:    0.24;
        cost_factor:                    60;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            55;
        reliability_decay:              12;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_DF4BEX), string(STR_LIVERY_EXPORT, string(STR_DPRK_LIVERY), string(STR_UKRAINE_LIVERY)), string(STR_CAT_LOCO));
        name:                           switch_name_series;
