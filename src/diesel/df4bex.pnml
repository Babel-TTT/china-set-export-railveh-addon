}

spriteset (spriteset_df4bex_purchase_dprk, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("diesel", "df4bex-dprk")
}

spriteset (spriteset_df4bex_ukraine, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("diesel", "df4bex-ukraine")
}

spriteset (spriteset_df4bex_purchase_ukraine, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("diesel", "df4bex-ukraine")
}

