        purchase:                       spriteset_df4dex_purchase;
        visual_effect_and_powered:      switch_df4dex_visual;

        // Stats
        cost_factor:                    78;
        running_cost_factor:            68 * runningcostfactor();
        purchase_running_cost_factor:   204;
    }
