/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_df4dex_visual, position_in_articulated_veh % 1) {
    0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_df4dex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("diesel", "df4dex")
}

spriteset (spriteset_df4dex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("diesel", "df4dex")
}

