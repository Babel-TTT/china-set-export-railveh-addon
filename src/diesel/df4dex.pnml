item (FEAT_TRAINS, df4dex) {
    property {
        // Menu
        name:                           string(STR_NAME_DF4DEX);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_DIESEL;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2000,01,01);
        model_life:                     50;
        retire_early:                   25;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          145 km/h;
        power:                          2940 kW;
        weight:                         138 ton;
        tractive_effort_coefficient:    0.25;
        cost_factor:                    78;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            68;
        reliability_decay:              10;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_DF4DEX), string(STR_LIVERY_EXPORT, string(STR_ORIGINAL)), string(STR_CAT_LOCO));
        name:                           switch_name_series;
        can_attach_wagon:               locowagon;

        // Graphics
