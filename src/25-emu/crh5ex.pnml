/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_crh5ex_articulated_part, extra_callback_info1) {
    1..2: return crh5ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_crh5ex_visual, position_in_articulated_veh % 3) {
    1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_crh5ex_capacity, position_in_articulated_veh % 3) {
    1: return 100;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_crh5ex_power, position_in_articulated_veh % 3) {
    1: return 5500;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_crh5ex_weight, position_in_articulated_veh) {
    return 50;
}

switch (FEAT_TRAINS, SELF, switch_crh5ex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_crh5ex;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
 * ========================================================================== */

spriteset (spriteset_crh5ex, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("25-emu", "crh5ex")
}

spriteset (spriteset_crh5ex_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("25-emu", "crh5ex")
}

