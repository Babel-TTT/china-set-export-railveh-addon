/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_crh6ex_articulated_part, extra_callback_info1) {
    1..2: return crh6ex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_crh6ex_visual, position_in_articulated_veh % 3) {
    1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_crh6ex_capacity, position_in_articulated_veh % 3) {
    1: return 120;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_crh6ex_power, position_in_articulated_veh % 3) {
    1: return 3000;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_crh6ex_weight, position_in_articulated_veh) {
    return 40;
}

switch (FEAT_TRAINS, SELF, switch_crh6ex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_crh6ex;
    empty_sprites;
}

