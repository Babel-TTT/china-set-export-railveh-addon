/* ==========================================================================
 *  China Set: Export Rail Vehicles Add-on
 *  src/template.pnml -- sprite templates
 *
 *  Sprite sheets are produced by gorender / renderobject from the .vox models
 *  in gfx/.  Every sheet is 992 x 166 px and holds the eight isometric views
 *  in this order (see gfx/manifest.json):
 *
 *    #0 angle   0  -> [  0, 0,  36, 166]
 *    #1 angle  45  -> [ 44, 0, 120, 116]
 *    #2 angle  90  -> [172, 0, 192,  80]
 *    #3 angle 135  -> [372, 0, 120, 116]
 *    #4 angle 180  -> [500, 0,  36, 166]
 *    #5 angle 225  -> [544, 0, 120, 116]
 *    #6 angle 270  -> [672, 0, 192,  80]
 *    #7 angle 315  -> [872, 0, 120, 116]
 *
 *  Template syntax is  [x, y, x_end, y_end, x_offset, y_offset, file]
 *  and the two offsets are what actually position a sprite inside the 32 px
 *  tile.  Reversing a vehicle is done by swapping the two halves of the list,
 *  which is what template_reversed() below does.
 * ========================================================================== */

// Empty Template
template template_empty() {
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
  [0, 0, 2, 2, 0, 0, CROP, "gfx/empty.png"]
}

// Purchase Templates
template template_purchase_empty() {
    []
    []
    []
    []
    []
    []
    [0, 0, 2, 2, 0, 0, "gfx/empty.png"]
    []
}

template template_purchase (a, b) {
    // a: vehicle type (all lower cases), b: vehicle name (all lower cases)
    []
    []
    []
    []
    []
    []
    [672,   0, 192,  80, -96, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    []
}

template template_purchase_xl (a, b) {
    // a: vehicle type (all lower cases), b: vehicle name (all lower cases)
    []
    []
    []
    []
    []
    []
    [856,   0, 256,  80,-128, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    []
}

template template_standard (a, b) {
    [  0,   0,  36, 166, -14, -80, "gfx/"+a+"/"+b+"_32bpp.png"]
    [ 44,   0, 120, 116, -75, -72, "gfx/"+a+"/"+b+"_32bpp.png"]
    [172,   0, 192,  80, -96, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    [372,   0, 120, 116, -41, -72, "gfx/"+a+"/"+b+"_32bpp.png"]
    [500,   0,  36, 166, -14, -80, "gfx/"+a+"/"+b+"_32bpp.png"]
    [544,   0, 120, 116, -75, -72, "gfx/"+a+"/"+b+"_32bpp.png"]
    [672,   0, 192,  80, -96, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    [872,   0, 120, 116, -41, -72, "gfx/"+a+"/"+b+"_32bpp.png"]
}

// For stock that sits higher / lower on its bogies (export narrow gauge
// conversions, gauge changing stock, buffing gear of foreign railways).
template template_speciel_1 (a, b) {
    [  0,   0,  36, 166, -14, -72, "gfx/"+a+"/"+b+"_32bpp.png"]
    [ 44,   0, 120, 116, -83, -68, "gfx/"+a+"/"+b+"_32bpp.png"]
    [172,   0, 192,  80,-112, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    [372,   0, 120, 116, -49, -76, "gfx/"+a+"/"+b+"_32bpp.png"]
    [500,   0,  36, 166, -14, -88, "gfx/"+a+"/"+b+"_32bpp.png"]
    [544,   0, 120, 116, -67, -76, "gfx/"+a+"/"+b+"_32bpp.png"]
    [672,   0, 192,  80, -80, -62, "gfx/"+a+"/"+b+"_32bpp.png"]
    [872,   0, 120, 116, -33, -68, "gfx/"+a+"/"+b+"_32bpp.png"]
}

