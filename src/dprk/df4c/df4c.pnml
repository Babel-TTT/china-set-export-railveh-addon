}

spriteset (spriteset_df4c_purchase_korea_1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dprk/df4c", "df4c-korea-1")
}

spriteset (spriteset_df4c_korea_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("dprk/df4c", "df4c-korea-2")
}

spriteset (spriteset_df4c_purchase_korea_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
