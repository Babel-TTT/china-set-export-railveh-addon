/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_df4c_cargo_subtype, cargo_subtype) {
    0: return string(STR_LV_BLUEGREEN);
    1: return string(STR_LV_BLUEGREEN_ALT);
    2: return string(STR_LV_GREEN_W_WHITE);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_df4c_articulated_part, extra_callback_info1) {
    1..2: return df4c;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_df4c_capacity, position_in_articulated_veh % 3) {
    1: return 1;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_df4c_section_0, position_in_articulated_veh % 3) {
    1: spriteset_df4c_korea_1;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_df4c_section_1, position_in_articulated_veh % 3) {
    1: spriteset_df4c_korea_2;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_df4c_section_2, position_in_articulated_veh % 3) {
    1: spriteset_df4c_korea_3;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_df4c_graphics, cargo_subtype) {
    0: switch_df4c_section_0;
    1: switch_df4c_section_1;
    2: switch_df4c_section_2;
    switch_df4c_section_0;
}

