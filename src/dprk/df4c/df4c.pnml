}

spriteset (spriteset_df4c_korea_3, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("dprk/df4c", "df4c-korea-3")
}

spriteset (spriteset_df4c_purchase_korea_3, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("dprk/df4c", "df4c-korea-3")
}

/* ==========================================================================
 *  VEHICLE
 * ========================================================================== */

// Begin DF4C
/* name callback: series name in the depot window */
item (FEAT_TRAINS, df4c) {
    property {
        // Menu
        name:                           string(STR_NAME_DF4C);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_DIESEL;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2015,01,01);
        model_life:                     60;
        retire_early:                   30;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  20 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          100 km/h;
        power:                          2165 kW;
        weight:                         132 ton;
        tractive_effort_coefficient:    0.36;
        cost_factor:                    45;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            40;
        reliability_decay:              10;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_DF4C), string(STR_LIVERY_EXPORT, string(STR_LV_BLUEGREEN_ALT), string(STR_LV_GREEN_W_WHITE)), string(STR_CAT_LOCO));
        name:                           switch_name_series;
        cargo_subtype_text:             switch_df4c_cargo_subtype;
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_df4c_graphics;
        purchase:                       spriteset_df4c_purchase_korea_1;
        articulated_part:               switch_df4c_articulated_part;

        // Stats
        length:                         switch_length_2_6_2;
        cargo_capacity:                 switch_df4c_capacity;
        cost_factor:                    45;
        running_cost_factor:            40 * runningcostfactor();
        purchase_running_cost_factor:   120;
    }
}

