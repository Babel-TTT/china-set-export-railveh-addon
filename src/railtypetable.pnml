/* ==========================================================================
 *  China Set: Export Rail Vehicles Add-on
 *  src/railtypetable.pnml -- railtype label table
 *
 *  The labels follow the semi-standardised railtype scheme used by
 *  China Set: Trains / China Set: Tracks Neo:
 *
 *    first letter   gauge
 *      S  1435 mm (standard gauge)
 *      B  1520 mm (Russian broad gauge)
 *      N  1067/1000 mm (narrow gauge)
 *      n  762/600 mm (very narrow gauge)
 *      D  1435/1520 mm (dual / gauge-changing, "套轨")
 *    second letter  speed class (A slowest ... G unlimited)
 *    third letter   axle load class (A <= 15 t ... E >= 27 t)
 *    last letter    electrification
 *      N  non-electrified
 *      A  25 kV AC
 *      d  1.5 kV DC
 *      (  25 kV AC / 1.5 kV DC
 *      3  third rail
 *      Z  third rail / 1.5 kV DC
 *
 *  Export vehicles are the ones that have to work away from home, so the
 *  table deliberately declares the complete foreign set as well as the
 *  dual-gauge (D) labels needed by gauge-changing stock.
 * ========================================================================== */

railtypetable {
    RAIL,
    ELRL,
    MONO,
    MGLV,
    NGRL,
    ELNG,
    RLA0,
    ERA1,
    MTRO,
    "3RDR",

/* ---- 1435 mm standard gauge, non electrified ---- */
    SAAN: [SAAN, SABN, SACN, SADN, SAEN, RAIL],       //兼容性保留
    SABN: [SABN, SACN, SADN, SAEN, SAAN, RAIL],
    SACN: [SACN, SADN, SAEN, SAAN, RAIL],
    SADN: [SADN, SAEN, SAAN, RAIL],
    SAEN: [SAEN, SAAN, RAIL],

/* ---- 1435 mm standard gauge, 25 kV AC ---- */
    SAAA: [SAAA, SABA, SACA, SADA, SAEA, SAAE, ELRL],
    SABA: [SABA, SACA, SADA, SAEA, SAAA, SAAE, ELRL],
    SACA: [SACA, SADA, SAEA, SAAA, SAAE, ELRL],
    SADA: [SADA, "SBDA", SAEA, SAAA, SAAE, ELRL],  //适应轨道包修改
    SAEA: [SAEA, "SBEA", SAAA, SAAE, ELRL],        //适应轨道包修改

/* ---- 1435 mm standard gauge, 3 kV DC (DPRK, Poland, Italy...) ---- */
    SAAD: [SAAD, SAAE, ELRL],
    SABD: [SABD, SACD, SADD, SAAD, SAAE, ELRL],
    SACD: [SACD, SADD, SAAD, SAAE, ELRL],
    SADD: [SADD, SAAD, SAAE, ELRL],

/* ---- 1435 mm standard gauge, 1.5 kV DC ---- */
    SAAd: [SAAd, SAAD, SAAE, ELRL],
    SABd: [SABd, SACd, SADd, SAEd, "SBEd", SAAd, SABD, SAAD, SAAE, ELRL],
    SACd: [SACd, SADd, SAEd, SAAd, SACD, SAAD, SAAE, ELRL],
    SADd: [SADd, SAEd, SAAd, SADD, SAAD, SAAE, ELRL],
    SAEd: [SAEd, SAAd, SADD, SAAD, SAAE, ELRL],

/* ---- 1435 mm standard gauge, third rail ---- */
    SAA3: [SAA3, SAB3, SAC3, SAD3, "3RDR", MTRO, ELRL],
    SAB3: [SAB3, SAC3, SAD3, SAA3, "3RDR", MTRO, ELRL],
    SAC3: [SAC3, SAD3, SAA3, "3RDR", MTRO, ELRL],
    SAD3: [SAD3, SAA3, "3RDR", MTRO, ELRL],

/* ---- 1435 mm standard gauge, 25 kV AC / 1.5 kV DC dual system ---- */
    SAA28: ["SAA(", SAAE, ELRL],
    SAB28: ["SAB(", "SAA(", SAAE, ELRL],
    SAC28: ["SAC(", "SAA(", SAAE, ELRL],
    SAD28: ["SAD(", "SAA(", SAAE, ELRL],

/* ---- 1520 mm Russian broad gauge, non electrified ---- */
    BAAN: [BAAN, RLA0, RAIL],
    BABN: [BABN, BACN, BADN, BAAN, RLA0, RAIL],
    BACN: [BACN, BADN, BAAN, RLA0, RAIL],
    BADN: [BADN, BAAN, RLA0, RAIL],
    BAEN: [BAEN, BAAN, RLA0, RAIL],

/* ---- 1520 mm Russian broad gauge, 25 kV AC ---- */
    BAAA: [BAAA, BAAE, ERA1, ELRL],
    BABA: [BABA, BACA, BADA, BAAA, BAAE, ERA1, ELRL],
    BACA: [BACA, BADA, BAAA, BAAE, ERA1, ELRL],
    BADA: [BADA, BAAA, BAAE, ERA1, ELRL],
    BAEA: [BAEA, BAAA, BAAE, ERA1, ELRL],

/* ---- 1435 / 1520 mm dual gauge (套轨) ---- */
    DAAN: [DAAN, DABN, DACN, DADN, DAEN, SAAN, SABN, SACN, SADN, SAEN, BAAN, BABN, BACN, BADN, RAIL],
    DABN: [DABN, DACN, DADN, DAEN, DAAN, SABN, SACN, SADN, SAEN, SAAN, BABN, BACN, BADN, BAAN, RAIL],
    DACN: [DACN, DADN, DAEN, DAAN, SACN, SADN, SAEN, SAAN, BACN, BADN, BAAN, RAIL],
    DADN: [DADN, DAAN, SADN, BADN, SAAN, BAAN, RAIL],
    DAAA: [DAAA, DABA, DACA, DADA, DAEA, DAAE, SAAA, SABA, SACA, SADA, SAEA, SAAE, BAAA, BABA, BACA, BADA, BAAE, ELRL],
    DABA: [DABA, DACA, DADA, DAEA, DAAA, DAAE, SABA, SACA, SADA, SAEA, SAAA, SAAE, BABA, BACA, BADA, BAEA, BAAE, ELRL],
    DACA: [DACA, DADA, DAEA, DAAA, DAAE, SACA, SADA, SAEA, SAAA, SAAE, BACA, BADA, BAAE, ELRL],
    DADA: [DADA, DAEA, DAAA, DAAE, SADA, SAEA, SAAA, SAAE, BADA, BAAE, ELRL],

/* ---- 1067 / 1000 mm metre & Cape gauge (South East Asia, Africa) ---- */
    NAAN: [NAAN, NGRL],
    NACN: [NACN, NAAN, NGRL],
    NAAD: [NAAD, NAAE, ELNG],
    NACA: [NACA, NAAA, NAAE, ELNG],
    NAAA: [NAAA, NAAE, ELNG],
    NACD: [NACD, NAAD, NAAE, ELNG],

/* ---- 762 / 600 mm very narrow gauge ---- */
    nAAN: [nAAN, NAAN, NGRL],
    nAAA: [nAAA, nAAE, NAAA, NAAE, ELNG],
}
