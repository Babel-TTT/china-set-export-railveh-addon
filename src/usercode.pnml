// Begin CKD4A
/* name callback: series name in the depot window */
item (FEAT_TRAINS, ckd4a) {
    property {
        // Menu
        name:                           string(STR_NAME_CKD4A);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_DIESEL;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1993,01,01);
        model_life:                     40;
        retire_early:                   20;
        vehicle_life:                   25;
        track_type:                     BACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          100 km/h;
        power:                          1000 kW;
        weight:                         92 ton;
        tractive_effort_coefficient:    0.25;
        cost_factor:                    45;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            40;
        reliability_decay:              12;
        bitmask_vehicle_info:           bitmask(2);
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_EXPORT, string(STR_FULL_NAME_CKD4A), string(STR_LIVERY_EXPORT, string(STR_BUILD_YEAR)), string(STR_CAT_LOCO));
        name:                           switch_name_series;
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        spriteset_ckd4a;
        purchase:                       spriteset_ckd4a_purchase;
        visual_effect_and_powered:      switch_ckd4a_visual;

        // Stats
        cost_factor:                    45;
        running_cost_factor:            40 * runningcostfactor();
        purchase_running_cost_factor:   120;
    }
}

