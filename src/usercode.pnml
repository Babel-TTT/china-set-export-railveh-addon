        speed:                          200 km/h;
        power:                          3000 kW;
        weight:                         120 ton;
        tractive_effort_coefficient:    0.2;
        cost_factor:                    105;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            92;
        reliability_decay:              8;
        bitmask_vehicle_info:           bitmask(2);
