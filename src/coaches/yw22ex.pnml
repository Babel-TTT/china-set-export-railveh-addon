    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_yw22ex_capacity, position_in_articulated_veh % 3) {
    1: return 60;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_yw22ex_weight, position_in_articulated_veh) {
    return 15;
}

switch (FEAT_TRAINS, SELF, switch_yw22ex_graphics, position_in_articulated_veh % 3) {
