    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_kd25tex_visual, position_in_articulated_veh % 3) {
    1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, ENABLE_WAGON_POWER);
    return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch (FEAT_TRAINS, SELF, switch_kd25tex_capacity, position_in_articulated_veh % 3) {
    1: return 0;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_kd25tex_weight, position_in_articulated_veh) {
    return 17;
}

switch (FEAT_TRAINS, SELF, switch_kd25tex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_kd25tex;
    empty_sprites;
}

