/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_ca25tex_articulated_part, extra_callback_info1) {
    1..2: return ca25tex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_ca25tex_capacity, position_in_articulated_veh % 3) {
    1: return 48;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_ca25tex_weight, position_in_articulated_veh) {
    return 16;
}

switch (FEAT_TRAINS, SELF, switch_ca25tex_graphics, position_in_articulated_veh % 3) {
    1: spriteset_ca25tex;
    empty_sprites;
}

/* ==========================================================================
 *  SPRITESETS
