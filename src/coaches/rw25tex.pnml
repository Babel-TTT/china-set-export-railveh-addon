/* ==========================================================================
 *  SWITCHES  (callbacks, livery and cargo selection)
 * ========================================================================== */

switch (FEAT_TRAINS, SELF, switch_rw25tex_cargo_subtype, cargo_subtype) {
    0: return string(STR_BUILD_YEAR);
    1: return string(STR_EXPORT_GREEN);
    return CB_RESULT_NO_TEXT;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_articulated_part, extra_callback_info1) {
    1..2: return rw25tex;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_capacity, position_in_articulated_veh % 3) {
    1: return 36;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_weight, position_in_articulated_veh) {
    return 16;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_livery_auto, build_year) {
    spriteset_rw25tex_green;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_livery, cargo_subtype) {
    0: switch_rw25tex_livery_auto;
    1: spriteset_rw25tex_green;
    switch_rw25tex_livery_auto;
}

switch (FEAT_TRAINS, SELF, switch_rw25tex_graphics, position_in_articulated_veh % 3) {
    1: switch_rw25tex_livery;
    empty_sprites;
}

